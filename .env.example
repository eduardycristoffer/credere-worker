# Segredo que o Lovable usa para chamar este worker (Authorization: Bearer ...)
WORKER_SECRET=troque-por-um-segredo-longo

# Contas da Credere por loja (slug da loja no Lovable -> login/senha).
# Uma linha de JSON. Cadastre direto no Railway, nunca no chat nem no git.
# Exemplo: {"lima-motors":{"login":"email@loja.com","senha":"..."},"outra-loja":{"login":"...","senha":"..."}}
CREDERE_ACCOUNTS={}

# Base do portal (sem barra no final)
CREDERE_BASE_URL=https://m.meucredere.com.br

# Para onde o resultado volta (endpoint no Lovable) e o token dele
LOVABLE_CALLBACK_URL=
LOVABLE_CALLBACK_TOKEN=

# Espaçamento entre consultas (ms) e tempo máximo esperando os bancos
MIN_INTERVALO_MS=8000
MAX_INTERVALO_MS=20000
RESULT_TIMEOUT_MS=120000
